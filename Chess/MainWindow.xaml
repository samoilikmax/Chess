<Window x:Class="Chess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chess"
        mc:Ignorable="d"
        Title="Chess" Width="800" SizeToContent="Height"
        Icon="/Icons/icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#101010"
        KeyDown="Window_KeyDown">
    <Viewbox>
        <!-- Внешняя обёртка: три колонки — панель слева, доска, панель справа -->
        <Grid Width="800" Height="600">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="600"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: белые фигуры съеденные чёрными -->
            <Border Grid.Column="0"
                    Background="#1a1a1a"
                    Margin="4"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Captured"
                               Foreground="#888"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,4"/>
                    <TextBlock Text="by Black"
                               Foreground="#888"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <WrapPanel x:Name="CapturedByBlack"
                               HorizontalAlignment="Center"
                               Margin="4,0"/>
                </StackPanel>
            </Border>

            <!-- Центр: доска (не трогаем совсем) -->
            <Grid x:Name="BoardGrid"
                  Grid.Column="1"
                  Width="600"
                  Height="600"
                  MouseDown="BoardGrid_MouseDown">
                <Grid.Background>
                    <ImageBrush ImageSource="/Icons/Board.png"/>
                </Grid.Background>

                <UniformGrid x:Name="HighlightGrid"
                             Rows="8"
                             Columns="8"/>

                <UniformGrid x:Name="PieceGrid"
                             Rows="8"
                             Columns="8"
                             RenderOptions.BitmapScalingMode="HighQuality"/>

                <ContentControl x:Name="MenuContainer"/>
            </Grid>

            <!-- Правая панель: чёрные фигуры съеденные белыми -->
            <Border Grid.Column="2"
                    Background="#1a1a1a"
                    Margin="4"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Captured"
                               Foreground="#888"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,4"/>
                    <TextBlock Text="by White"
                               Foreground="#888"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <WrapPanel x:Name="CapturedByWhite"
                               HorizontalAlignment="Center"
                               Margin="4,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>
</Window>