<UserControl x:Class="Chess.TimeControlMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Chess"
             mc:Ignorable="d">

    <Border Style="{StaticResource BorderStyle}"
            Width="360"
            Height="340">
        <StackPanel Margin="20">

            <TextBlock Text="TIME CONTROL"
                       Style="{StaticResource TextStyle}"
                       FontSize="22"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Quick game"
                       Style="{StaticResource TextStyle}"
                       FontSize="12"
                       Margin="0,0,0,8"/>

            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                <Button Content="1 min"    Width="70" Height="28" Margin="4"
                        Style="{StaticResource ButtonStyle}"
                        Tag="60,0" Click="Preset_Click"/>
                <Button Content="3 min"    Width="70" Height="28" Margin="4"
                        Style="{StaticResource ButtonStyle}"
                        Tag="180,0" Click="Preset_Click"/>
                <Button Content="5 min"    Width="70" Height="28" Margin="4"
                        Style="{StaticResource ButtonStyle}"
                        Tag="300,0" Click="Preset_Click"/>
                <Button Content="10 min"   Width="70" Height="28" Margin="4"
                        Style="{StaticResource ButtonStyle}"
                        Tag="600,0" Click="Preset_Click"/>
                <Button Content="3+2"      Width="70" Height="28" Margin="4"
                        Style="{StaticResource ButtonStyle}"
                        Tag="180,2" Click="Preset_Click"/>
                <Button Content="5+3"      Width="70" Height="28" Margin="4"
                        Style="{StaticResource ButtonStyle}"
                        Tag="300,3" Click="Preset_Click"/>
                <Button Content="10+5"     Width="70" Height="28" Margin="4"
                        Style="{StaticResource ButtonStyle}"
                        Tag="600,5" Click="Preset_Click"/>
                <Button Content="No limit" Width="70" Height="28" Margin="4"
                        Style="{StaticResource ButtonStyle}"
                        Tag="0,0" Click="Preset_Click"/>
            </WrapPanel>

            <TextBlock Text="Custom"
                       Style="{StaticResource TextStyle}"
                       FontSize="12"
                       Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="4,0">
                    <TextBlock Text="Minutes"
                               Style="{StaticResource TextStyle}"
                               FontSize="11"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="MinutesBox"
                             Text="5"
                             FontSize="16"
                             TextAlignment="Center"
                             Background="#1a1a1a"
                             Foreground="#ffa274"
                             BorderBrush="#260000"
                             BorderThickness="2"
                             Padding="4"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="4,0">
                    <TextBlock Text="Increment (sec)"
                               Style="{StaticResource TextStyle}"
                               FontSize="11"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="IncrementBox"
                             Text="0"
                             FontSize="16"
                             TextAlignment="Center"
                             Background="#1a1a1a"
                             Foreground="#ffa274"
                             BorderBrush="#260000"
                             BorderThickness="2"
                             Padding="4"/>
                </StackPanel>
            </Grid>

            <Button Content="START GAME"
                    Style="{StaticResource ButtonStyle}"
                    Width="140"
                    Height="34"
                    FontSize="14"
                    Click="Start_Click"/>
        </StackPanel>
    </Border>
</UserControl>